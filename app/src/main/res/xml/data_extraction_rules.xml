<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Записи детских голосов («Свои голоса», filesDir/voices) не уходят ни в облачную копию, ни при переносе на другое устройство. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="voices" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="voices" />
    </device-transfer>
</data-extraction-rules>
